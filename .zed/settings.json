{
  "formatter": [{ "external": { "command": "dprint", "arguments": ["fmt", "--stdin", "{buffer_path}"] } }],
  "prettier": { "allowed": false },
  "wrap_guides": [80],
  "languages": {
    "Rust": { "wrap_guides": [100] },
    "TOML": { "wrap_guides": [140] },
    "YAML": { "wrap_guides": [120] }
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "features": "all"
        }
      }
    }
  }
}
