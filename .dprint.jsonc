{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "typescript": {},
  "json": {},
  "markdown": {
    "emphasisKind": "asterisks",
    "textWrap": "always",
  },
  "malva": {},
  "markup": {},
  "yaml": {
    "printWidth": 150,
    "proseWrap": "always",
    "preferSingleLine": true,
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [{
      "command": "tombi format --stdin-filename {{file_path}} -",
      "exts": [
        "toml",
      ],
    }, {
      "command": "rustfmt",
      "exts": [
        "rs",
      ],
      "cacheKeyFiles": [
        "rustfmt.toml",
        "rust-toolchain.toml",
      ],
    }],
  },
  "includes": [
    ".github/**",
    "**",
  ],
  "excludes": [
    "**/node_modules",
    "**/*.lock",
    "**/target",
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.23.0",
    "https://plugins.dprint.dev/markdown-0.21.1.wasm", // https://github.com/dprint/dprint-plugin-markdown/issues/265
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.3",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
  ],
}
