{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "dprint": {
      "command": ["dprint", "fmt", "$FILE"],
      "extensions": [".json", ".jsonc", ".md", ".rs", ".toml", ".ts", ".yaml", ".yml"],
    },
  },
  "mcp": {
    "bun": { "enabled": false },
    "bun-docs": { "enabled": false },
  },
  "command": {
    "orchestrate": {
      "template": "Dispatch researchers/planners -> implementers/builders -> reviewers/critics -> fixers/builders (THIS WORKFLOW FOREACH ITERATION PLS)",
      "description": "Orchestrator",
    },
  },
}
